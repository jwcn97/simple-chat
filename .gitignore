# Dependencies
node_modules/

# Logs
npm-debug.log*
logs/
*.log

# Environment variables
.env
.env.local

# OS files
.DS_Store

# Editor
.vscode/
.idea/

# Downloaded TLS trust certs (regenerate via the curl commands in the
# Keyspaces setup notes — not source, no need to track)
server/keyspaces/*.pem
server/keyspaces/*.crt

# JWT signing key pair (regenerate via openssl — private.pem is a real
# secret, never commit it)
server/keys/
